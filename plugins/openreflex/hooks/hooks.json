{
  "description": "OpenReflex ambient capture (Claude Code)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code SessionStart --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code UserPromptSubmit --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code PreToolUse --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code PostToolUse --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code PostToolUseFailure --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code PreCompact --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code Stop --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openreflex hook claude-code SessionEnd --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
